{
  "name": "mmfinder",
  "private": true,
  "version": "1.0.0",
  "description": "Monsters & Memories world atlas — zones, camps, and notes",
  "scripts": {
    "dev": "node scripts/export-static.js && vite --config client/vite.config.js",
    "server": "node --watch server/index.js",
    "client": "vite --config client/vite.config.js",
    "export:static": "node scripts/export-static.js",
    "build": "node scripts/export-static.js && vite build --config client/vite.config.js",
    "test": "node --test shared/story.test.js shared/spells.test.js shared/spell-wiki.test.js shared/release.test.js shared/field.test.js shared/place.test.js shared/who-outline.test.js client/src/notes-store.test.js client/src/characters-store.test.js client/src/gear.test.js server/maps-asset.test.js server/items-quests.test.js",
    "import:who": "node scripts/download-who.js",
    "start": "node server/index.js",
    "import:wiki-items": "node server/import-wiki-items.js",
    "import:wiki-mobs": "node server/import-wiki-mobs.js",
    "import:wiki-spells": "node scripts/import-wiki-spells.mjs"
  },
  "dependencies": {
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "sql.js": "^1.14.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.4",
    "vite": "^5.4.14"
  }
}
